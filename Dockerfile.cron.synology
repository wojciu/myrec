# ===================================
# Dockerfile.cron do budowania NA Synology
# Standardowa instalacja npm wewnątrz kontenera
# ===================================

FROM node:20-alpine

WORKDIR /app

# Install dependencies
COPY package.json package-lock.json* ./
RUN npm ci

# Copy scripts and Prisma
COPY scripts ./scripts
COPY prisma ./prisma

# Ustaw tymczasową DATABASE_URL dla buildu
ENV DATABASE_URL="file:./dev.db"

# Install tsx for running TypeScript
RUN npx tsx --version

# Generate Prisma Client
RUN npx prisma generate

ENV NODE_ENV=production

CMD ["npx", "tsx", "scripts/cron.ts"]
