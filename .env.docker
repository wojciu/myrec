# Database (SQLite w Docker - persisted volume)
DATABASE_URL=file:./prisma/prod.db

# JWT Secrets - GENERUJ NOWE!
# Użyj: openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_GENERATE_WITH_OPENSSL
JWT_REFRESH_SECRET=CHANGE_THIS_ALSO_GENERATE_WITH_OPENSSL

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
