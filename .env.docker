# Database (SQLite w Docker - persisted volume)
DATABASE_URL=file:./prisma/prod.db

# JWT Secrets - GENERUJ NOWE przed użyciem!
# Użyj: openssl rand -base64 32
JWT_SECRET=ZMIEŃ_TEN_TEKST_NA_WYGENEROWANY_SEKRET
JWT_REFRESH_SECRET=ZMIEŃ_TEN_TEKST_TAKŻE_NA_WYGENEROWANY_SEKRET

# Application URL - zmień na swoją domenę
NEXT_PUBLIC_APP_URL=http://localhost:3000
