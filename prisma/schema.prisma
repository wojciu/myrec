// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String         @id @default(uuid())
  email          String         @unique
  passwordHash   String
  displayName    String
  role           String         @default("receptionist")
  departmentId   String?
  department     Department?    @relation(fields: [departmentId], references: [id])
  createdEntries Entry[]        @relation("AuthorEntries")
  readEntries    EntryReadBy[]  @relation("UserReadEntries")
  assignedTasks  Task[]         @relation("AssigneeTasks")
  createdTasks   Task[]         @relation("CreatorTasks")
  notifications  Notification[]  @relation("UserNotifications")
  comments       TaskComment[]  @relation("CommentAuthor")
  activities     TaskActivity[] @relation("ActivityAuthor")
  createdAt      DateTime       @default(now())
}

model Department {
  id              String         @id @default(uuid())
  name            String
  users           User[]
  visibleEntries  Entry[]        @relation("VisibleToEntries")
  assignedTasks   Task[]         @relation("DepartmentTasks")
  createdAt       DateTime       @default(now())
}

model EntryCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  color     String   @default("bg-gray-100 text-gray-800")
  entries   Entry[]
  createdAt DateTime @default(now())
}

model Entry {
  id                   String         @id @default(uuid())
  authorId             String
  author               User           @relation("AuthorEntries", fields: [authorId], references: [id])
  title                String?
  body                 String
  categoryId           String
  category             EntryCategory  @relation(fields: [categoryId], references: [id])
  visibleToDepartments Department[]   @relation("VisibleToEntries")
  readBy               EntryReadBy[]
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  tasks                Task[]
  attachments          Attachment[]
  notifications        Notification[]
}

model EntryReadBy {
  id        String   @id @default(uuid())
  entryId   String
  entry     Entry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("UserReadEntries", fields: [userId], references: [id], onDelete: Cascade)
  readAt    DateTime @default(now())

  @@unique([entryId, userId])
}

model Task {
  id                   String         @id @default(uuid())
  title                String
  description          String?
  status               String         @default("open")
  priority             Int            @default(2)
  createdById          String?
  createdBy            User?          @relation("CreatorTasks", fields: [createdById], references: [id])
  assigneeId           String?
  assignee             User?          @relation("AssigneeTasks", fields: [assigneeId], references: [id])
  assigneeDepartmentId String?
  assigneeDepartment   Department?    @relation("DepartmentTasks", fields: [assigneeDepartmentId], references: [id])
  entryId              String?
  entry                Entry?         @relation(fields: [entryId], references: [id])
  dueAt                DateTime?
  reminderAt           DateTime?
  reminderSentAt       DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  attachments          Attachment[]
  notifications        Notification[]
  comments             TaskComment[]
  activities           TaskActivity[]
}

model TaskComment {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("CommentAuthor", fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
  @@index([createdAt])
}

model Attachment {
  id        String   @id @default(uuid())
  entryId   String?
  entry     Entry?   @relation(fields: [entryId], references: [id])
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id])
  filePath  String
  fileName  String
  contentType String
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  entryId   String?
  entry     Entry?   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  read      Boolean  @default(false)
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([createdAt])
}

model TaskActivity {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("ActivityAuthor", fields: [userId], references: [id], onDelete: Cascade)
  type      String
  details   String?
  createdAt DateTime @default(now())

  @@index([taskId])
  @@index([createdAt])
}
